# BudgetBridge Backend Environment Variables
# Copy this file to .env and update values for your environment

# Database Configuration
DB_PASSWORD=your_secure_password_here
POSTGRES_USER=budgetbridge
POSTGRES_DB=budgetbridge
DB_HOST=localhost
DB_PORT=5432

# ASP.NET Core Environment
ASPNETCORE_ENVIRONMENT=Development
ASPNETCORE_URLS=http://+:8080

# Logging
Logging__LogLevel__Default=Information
Logging__LogLevel__Microsoft.AspNetCore=Warning
Logging__LogLevel__Microsoft.EntityFrameworkCore=Information

# CORS (comma-separated origins)
CORS_ORIGINS=http://localhost:5173

# Connection String (assembled from above values)
# ConnectionStrings__DefaultConnection=Host=${DB_HOST};Port=${DB_PORT};Database=${POSTGRES_DB};Username=${POSTGRES_USER};Password=${DB_PASSWORD}
