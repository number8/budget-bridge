	},
	"pnpm": {
		"onlyBuiltDependencies": ["@biomejs/biome", "esbuild"]
	},
	"devDependencies": {
		"@biomejs/biome": "^1.9.4",
		"@tailwindcss/vite": "^4.1.7",
		"@tanstack/router-plugin": "^1.120.2",
		"@testing-library/jest-dom": "^6.6.3",
